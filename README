    │
    ├── user/
    │   ├── models.py        # User DB model
    │   ├── dtos.py          # Request/Response schemas
    │   ├── controller.py    # Auth logic
    │   └── router.py        # API routes
    │
    └── utils/
        ├── db.py            # DB connection & session
        ├── settings.py      # Environment config
